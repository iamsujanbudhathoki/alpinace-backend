<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Booking Request Received
</h1>

<p style="font-size: 15px; font-weight: 600; color: #0a0a0a; margin: 0 0 12px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Namaste <%= guestName %>,
</p>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 20px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Thank you for choosing Alpine Ace. We have received your booking request for <strong style="color: #0a0a0a;"><%= packageName %></strong>. Your reservation reference is <strong style="color: #0a0a0a;"><%= reference %></strong>.
</p>

<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #737373; margin: 20px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Booking Summary
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Booking Reference', value: reference, isCode: true },
    { label: 'Package / Trip', value: packageName },
    { label: 'Travel Dates', value: formatHumanDateRange(typeof startDate !== 'undefined' ? startDate : undefined, typeof endDate !== 'undefined' ? endDate : undefined) },
    { label: 'Group Size', value: (typeof groupSize !== 'undefined' && groupSize ? groupSize : 1) + ' ' + (groupSize === 1 ? 'traveler' : 'travelers') },
    { label: 'Estimated Total', value: '$' + (typeof totalAmountUSD !== 'undefined' && totalAmountUSD ? totalAmountUSD.toLocaleString() : 0) + ' USD' },
    { label: 'Special Requests', value: (typeof specialRequests !== 'undefined' && specialRequests ? specialRequests : 'None') }
  ]
}) %>

<%- include('partials/callout', {
  title: 'What Happens Next',
  text: 'Our operations team is verifying lodge availability and trek permits for your requested dates. We will follow up with you within 12 hours to confirm your reservation and guide arrangements.',
  type: 'info'
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/contact',
  label: 'Contact Expedition Concierge'
}) %>

<p style="font-size: 13px; line-height: 1.6; color: #737373; margin: 16px 0 0 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Keep your reference code <code style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; background-color: #f5f5f5; border: 1px solid #e5e5e5; padding: 2px 6px; border-radius: 4px; color: #0a0a0a; font-weight: 600;"><%= reference %></code> handy for any future inquiries.
</p>
