<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  New Booking Request
</h1>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 20px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  A new trip booking request has been submitted through the website.
</p>

<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #737373; margin: 20px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Booking &amp; Traveler Details
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Booking Reference', value: reference, isCode: true },
    { label: 'Guest Name', value: guestName },
    { label: 'Email Address', value: email, isLink: true, href: 'mailto:' + email },
    { label: 'Phone / WhatsApp', value: (typeof phone !== 'undefined' && phone) ? phone : 'Not provided' },
    { label: 'Country', value: (typeof country !== 'undefined' && country) ? country : 'N/A' },
    { label: 'Package Name', value: packageName },
    { label: 'Departure & Return', value: (typeof startDate !== 'undefined' && startDate ? startDate : 'TBD') + ' to ' + (typeof endDate !== 'undefined' && endDate ? endDate : 'TBD') },
    { label: 'Group Size', value: (typeof groupSize !== 'undefined' && groupSize ? groupSize : 1) + ' ' + (groupSize === 1 ? 'traveler' : 'travelers') },
    { label: 'Total Amount', value: '$' + (typeof totalAmountUSD !== 'undefined' && totalAmountUSD ? totalAmountUSD.toLocaleString() : 0) + ' USD' },
    { label: 'Special Requests', value: (typeof specialRequests !== 'undefined' && specialRequests ? specialRequests : 'None') }
  ]
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/admin/bookings',
  label: 'View Booking in Dashboard'
}) %>

<p style="font-size: 13px; line-height: 1.6; color: #737373; margin: 12px 0 0 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Or email guest directly: <a href="mailto:<%= email %>?subject=RE:%20Alpine%20Ace%20Booking%20<%= reference %>%20-%20<%= encodeURIComponent(packageName) %>" style="color: #0a0a0a; font-weight: 600; text-decoration: underline;"><%= email %></a>
</p>
