<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Your Verification Code
</h1>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 18px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Please use the one-time verification code below to complete your sign-in:
</p>

<div style="background-color: #fafaf9; border: 1px solid #e5e5e5; border-radius: 6px; padding: 18px 20px; margin: 20px 0; text-align: center;">
  <span style="font-size: 28px; font-weight: 700; letter-spacing: 6px; color: #0a0a0a; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; display: inline-block;">
    <%= otp %>
  </span>
</div>

<p style="font-size: 13px; line-height: 1.6; color: #737373; margin: 0 0 16px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  This code will expire in <strong style="color: #0a0a0a;"><%= (typeof expiresInMinutes !== 'undefined' && expiresInMinutes) ? expiresInMinutes : 10 %> minutes</strong>. Please keep it confidential.
</p>

<%- include('partials/callout', {
  title: 'Security Notice',
  text: 'If you did not request this verification code, no action is needed. Your account remains secure.',
  type: 'info'
}) %>
