<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Your Trip Proposal &amp; Quote
</h1>

<p style="font-size: 15px; font-weight: 600; color: #0a0a0a; margin: 0 0 12px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Namaste <%= guestName %>,
</p>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 18px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Thank you for reaching out to Alpine Ace. Below are your customized trip details and proposal for <strong style="color: #0a0a0a;"><%= (typeof interestedTrip !== 'undefined' && interestedTrip) ? interestedTrip : 'your upcoming trek' %></strong>:
</p>

<div style="background-color: #fafaf9; border: 1px solid #e5e5e5; border-left: 3px solid #eab308; border-radius: 6px; padding: 18px 20px; margin: 20px 0; font-size: 14px; line-height: 1.65; color: #0a0a0a; white-space: pre-line; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <%= message %>
</div>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 20px 0 16px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  If you would like to adjust any dates, modify the route, or ask questions, simply reply directly to this email. We are here to customize every detail for you.
</p>

<%- include('partials/button', {
  url: 'mailto:info@alpineacetreks.com?subject=RE:%20Trip%20Proposal%20-%20' + encodeURIComponent(typeof interestedTrip !== 'undefined' && interestedTrip ? interestedTrip : 'Trek'),
  label: 'Reply to Our Team'
}) %>
