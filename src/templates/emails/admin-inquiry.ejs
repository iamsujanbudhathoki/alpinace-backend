<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  New Trip Inquiry
</h1>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 20px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  A new traveler inquiry has been submitted through the website.
</p>

<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #737373; margin: 20px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Traveler &amp; Inquiry Details
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Guest Name', value: guestName },
    { label: 'Email Address', value: email, isLink: true, href: 'mailto:' + email },
    { label: 'Phone / WhatsApp', value: (typeof phone !== 'undefined' && phone) ? phone : 'Not provided' },
    { label: 'Interested Trip', value: (typeof interestedTrip !== 'undefined' && interestedTrip) ? interestedTrip : 'General Inquiry' },
    { label: 'Group Size', value: (typeof groupSize !== 'undefined' && groupSize ? groupSize : 1) + ' Traveler(s)' },
    { label: 'Travel Dates', value: formatHumanDate(typeof travelDates !== 'undefined' ? travelDates : undefined) },
    { label: 'Guest Message', value: (typeof message !== 'undefined' && message) ? message : 'None provided' }
  ]
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/admin/inquiries',
  label: 'View Inquiries in Dashboard'
}) %>

<p style="font-size: 13px; line-height: 1.6; color: #737373; margin: 12px 0 0 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Or reply directly to guest: <a href="mailto:<%= email %>?subject=RE:%20Alpine%20Ace%20Inquiry%20-%20<%= encodeURIComponent(typeof interestedTrip !== 'undefined' && interestedTrip ? interestedTrip : 'Expedition') %>" style="color: #0a0a0a; font-weight: 600; text-decoration: underline;"><%= email %></a>
</p>
