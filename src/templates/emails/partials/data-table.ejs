<% if (typeof rows !== 'undefined' && Array.isArray(rows) && rows.length > 0) { %>
  <% const validRows = rows.filter(r => r && r.value !== undefined && r.value !== null && r.value !== ''); %>
  <% if (validRows.length > 0) { %>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 20px 0; border-collapse: collapse;">
      <% validRows.forEach(function(row) { %>
        <tr>
          <td style="padding: 10px 12px 10px 0; font-size: 13px; font-weight: 700; color: #71717a; border-bottom: 1px solid #f4f4f5; width: 140px; vertical-align: top; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <%= row.label %>
          </td>
          <td style="padding: 10px 0; font-size: 14px; font-weight: 500; color: #000000; border-bottom: 1px solid #f4f4f5; vertical-align: top; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <% if (row.isLink && row.href) { %>
              <a href="<%= row.href %>" style="color: #000000; text-decoration: underline; font-weight: 600;"><%= row.value %></a>
            <% } else if (row.isCode) { %>
              <code style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; background-color: #f4f4f5; border: 1px solid #e4e4e7; padding: 3px 7px; border-radius: 4px; color: #000000; font-weight: 600;"><%= row.value %></code>
            <% } else { %>
              <%= row.value %>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </table>
  <% } %>
<% } %>
