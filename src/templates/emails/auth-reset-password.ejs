<h1 style="font-size: 20px; font-weight: 800; color: #09090b; margin: 0 0 16px 0; letter-spacing: -0.3px;">
  Reset Your Password
</h1>

<p style="font-size: 15px; font-weight: 700; color: #09090b; margin: 0 0 12px 0;">
  Hello <%= (typeof userName !== 'undefined' && userName) ? userName : 'there' %>,
</p>

<p style="font-size: 14px; line-height: 1.6; color: #3f3f46; margin: 0 0 24px 0;">
  We received a request to reset the password for <strong><%= email %></strong>. Click below to choose a new password:
</p>

<%- include('partials/button', {
  url: resetLink,
  label: 'Reset Password'
}) %>

<p style="font-size: 13px; line-height: 1.6; color: #71717a; margin: 16px 0 24px 0;">
  If the button does not work, copy and paste this link into your browser:<br />
  <a href="<%= resetLink %>" style="color: #d97706; text-decoration: underline; word-break: break-all; font-weight: 600;"><%= resetLink %></a>
</p>

<%- include('partials/callout', {
  title: 'Security Note',
  text: 'If you did not ask to reset your password, you can ignore this email. Your account is safe.',
  type: 'info'
}) %>
