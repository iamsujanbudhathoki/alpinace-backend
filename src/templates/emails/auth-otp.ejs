<h1 style="font-size: 18px; font-weight: 700; color: #0a0a0a; margin: 0 0 14px 0; line-height: 1.35; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Your Verification Code
</h1>

<p style="font-size: 13.5px; line-height: 1.6; color: #404040; margin: 0 0 16px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Please use the one-time verification code below to complete your sign-in:
</p>

<div style="background-color: #fafaf9; border: 1px solid #e5e5e5; border-radius: 6px; padding: 16px 20px; margin: 16px 0; text-align: center;">
  <span style="font-size: 26px; font-weight: 700; letter-spacing: 4px; color: #0a0a0a; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; display: inline-block;">
    <%= otp %>
  </span>
</div>

<p style="font-size: 13px; line-height: 1.55; color: #737373; margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  This code will expire in <strong style="color: #0a0a0a;"><%= (typeof expiresInMinutes !== 'undefined' && expiresInMinutes) ? expiresInMinutes : 10 %> minutes</strong>. Please keep it confidential.
</p>

<%- include('partials/callout', {
  title: 'Security Notice',
  text: 'If you did not request this verification code, no action is needed. Your account remains secure.',
  type: 'info'
}) %>
