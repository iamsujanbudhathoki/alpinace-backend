<h1 style="font-size: 18px; font-weight: 700; color: #0a0a0a; margin: 0 0 14px 0; line-height: 1.35; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Security Alert: Admin Account Locked
</h1>

<p style="font-size: 13.5px; line-height: 1.6; color: #404040; margin: 0 0 16px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  An administrator account has been temporarily locked following <strong style="color: #0a0a0a;">5 consecutive failed sign-in attempts</strong>.
</p>

<div style="font-size: 12px; font-weight: 600; color: #525252; margin: 16px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Lockout Event Details
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Account Name', value: adminName },
    { label: 'Account Email', value: adminEmail },
    { label: 'Lockout Time', value: formatHumanDateTime(typeof timestamp !== 'undefined' ? timestamp : undefined) },
    { label: 'IP Address', value: (typeof ip !== 'undefined' && ip) ? ip : 'Unknown', isCode: true }
  ]
}) %>

<%- include('partials/callout', {
  title: 'Action Required',
  text: 'If this was unexpected or unauthorized activity, please inspect system audit logs and verify administrator access immediately.',
  type: 'warning'
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/admin/settings',
  label: 'Inspect Security Logs'
}) %>
