<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fafaf9; border-top: 1px solid #f5f5f4;">
  <tr>
    <td style="padding: 24px 32px; text-align: left;">
      <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #71717a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        <% if (typeof footerText !== 'undefined' && footerText) { %>
          <%- footerText %>
        <% } else { %>
          &copy; <%= new Date().getFullYear() %> Alpine Ace Treks &amp; Expeditions Pvt. Ltd.<br />
          Tridevi Marg, Thamel, Kathmandu, Nepal &bull; <a href="mailto:info@alpineacetreks.com" style="color: #09090b; text-decoration: underline; font-weight: 500;">info@alpineacetreks.com</a>
        <% } %>
      </p>
    </td>
  </tr>
</table>
