<h1 style="font-size: 20px; font-weight: 800; color: #09090b; margin: 0 0 16px 0; letter-spacing: -0.3px;">
  Your Verification Code
</h1>

<p style="font-size: 14px; line-height: 1.6; color: #3f3f46; margin: 0 0 20px 0;">
  Here is your verification code to log in:
</p>

<div style="background-color: #fafaf9; border: 1px solid #e7e5e4; border-left: 4px solid #f59e0b; border-radius: 6px; padding: 20px; margin: 24px 0; text-align: center;">
  <span style="font-size: 32px; font-weight: 800; letter-spacing: 8px; color: #09090b; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">
    <%= otp %>
  </span>
</div>

<p style="font-size: 13px; line-height: 1.6; color: #71717a; margin: 0 0 20px 0;">
  This code will expire in <strong><%= (typeof expiresInMinutes !== 'undefined' && expiresInMinutes) ? expiresInMinutes : 10 %> minutes</strong>. Please keep it private.
</p>

<%- include('partials/callout', {
  title: 'Security Note',
  text: 'If you did not request a code, you can safely ignore this email.',
  type: 'info'
}) %>
