<h1 style="font-size: 20px; font-weight: 700; color: #0a0a0a; margin: 0 0 16px 0; letter-spacing: -0.01em; line-height: 1.3; font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Security Alert: Admin Sign-In
</h1>

<p style="font-size: 15px; font-weight: 600; color: #0a0a0a; margin: 0 0 12px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Hello <%= adminName %>,
</p>

<p style="font-size: 14px; line-height: 1.6; color: #404040; margin: 0 0 20px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  A new administrator sign-in was detected for your account.
</p>

<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #737373; margin: 20px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Session Details
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Account Email', value: adminEmail },
    { label: 'Sign-In Time', value: timestamp },
    { label: 'IP Address', value: ip, isCode: true },
    { label: 'Location', value: (typeof location !== 'undefined' && location) ? location : 'Localhost / Private Network' },
    { label: 'User Agent', value: userAgent }
  ]
}) %>

<%- include('partials/callout', {
  title: 'Was this you?',
  text: 'If you authorized this login, you can safely disregard this notice. If you did not sign in, please secure your account by updating your credentials immediately.',
  type: 'notice'
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/admin/settings',
  label: 'Review Account Security'
}) %>
