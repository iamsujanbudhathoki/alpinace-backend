<h1 style="font-size: 18px; font-weight: 700; color: #0a0a0a; margin: 0 0 14px 0; line-height: 1.35; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Inquiry Received
</h1>

<p style="font-size: 14px; font-weight: 600; color: #0a0a0a; margin: 0 0 10px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Namaste <%= guestName %>,
</p>

<p style="font-size: 13.5px; line-height: 1.6; color: #404040; margin: 0 0 16px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Thank you for reaching out to Alpine Ace. We have received your inquiry for <strong style="color: #0a0a0a;"><%= interestedTrip || 'your upcoming trip' %></strong>.
</p>

<div style="font-size: 12px; font-weight: 600; color: #525252; margin: 16px 0 6px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Inquiry Details
</div>

<%- include('partials/data-table', {
  rows: [
    { label: 'Interested Trip', value: interestedTrip || 'Custom Expedition / Trek' },
    { label: 'Travelers', value: (typeof groupSize !== 'undefined' && groupSize ? groupSize : 1) + ' ' + (groupSize === 1 ? 'traveler' : 'travelers') },
    { label: 'Travel Dates', value: formatHumanDate(typeof travelDates !== 'undefined' ? travelDates : undefined) },
    { label: 'Special Notes', value: (typeof message !== 'undefined' && message ? message : 'None provided') }
  ]
}) %>

<%- include('partials/callout', {
  title: 'What Happens Next',
  text: 'Our mountain travel specialists are reviewing route options, seasonal weather patterns, and guide availability. We will follow up with tailored recommendations within 12 hours.',
  type: 'info'
}) %>

<%- include('partials/button', {
  url: ((typeof websiteUrl !== 'undefined' && websiteUrl) ? websiteUrl : 'https://alpineacetreks.com') + '/trekking',
  label: 'Explore Expedition Packages'
}) %>

<p style="font-size: 13px; line-height: 1.55; color: #737373; margin: 14px 0 0 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  Need immediate assistance or wish to add custom requirements? Simply reply directly to this email.
</p>
